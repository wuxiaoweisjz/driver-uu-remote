[Unit]
Description=UU Remote on the dedicated X11 desktop
Requires=uu-x11-display.service
Wants=uu-x11-desktop.service uu-amf-helper.service
After=uu-x11-display.service uu-x11-desktop.service uu-amf-helper.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/uuyc-wine
ExecStop=/usr/bin/uuyc-wine --stop
TimeoutStartSec=120
TimeoutStopSec=25
Environment=DISPLAY=:99
Environment=XAUTHORITY=
Environment=XDG_SESSION_TYPE=x11
UnsetEnvironment=WAYLAND_DISPLAY

[Install]
WantedBy=default.target
