[Unit]
Description=UU Remote Wine stale-session guard
Wants=uu-x11-display.service
After=uu-amf-helper.service uu-x11-display.service

[Service]
Type=simple
ExecStart=%h/.local/libexec/uu-session-guard
Restart=always
RestartSec=3
Environment=UU_SESSION_GUARD_INTERVAL=15
Environment=DISPLAY=:99
Environment=XAUTHORITY=
Environment=XDG_SESSION_TYPE=x11
UnsetEnvironment=WAYLAND_DISPLAY

[Install]
WantedBy=default.target
